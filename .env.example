# ── Firebase client SDK (public — safe in frontend code) ─────────────────
# Copy from Firebase Console → Project Settings → Your apps → SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Firebase Admin SDK (server-side only — never expose these) ────────────
# Download from Firebase Console → Project Settings → Service Accounts → Generate new key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Razorpay API credentials — get these from https://dashboard.razorpay.com (Settings → API Keys)
# NEVER commit real values. This file ships placeholders only.
# Put the real values in a local .env file (git-ignored) and in your Vercel Project → Settings → Environment Variables.

# Public key id (safe to expose to the browser). Test keys start with rzp_test_, live keys with rzp_live_
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# SECRET key — server-side only. Never put this in frontend code, Git, or any prompt.
RAZORPAY_KEY_SECRET=your_key_secret_here

# Optional: set to "production" when deploying
NODE_ENV=development

# JWT authentication — generate a long random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Instagram → Events auto-sync (Instagram Graph API).
# Long-lived access token for a Business/Creator account. Leave blank to
# disable the feed (the Events page falls back gracefully).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=v21.0
INSTAGRAM_SYNC_INTERVAL_MINUTES=20
# Shared secret to protect POST /api/events/sync (used by Vercel Cron).
SYNC_SECRET=replace_with_a_random_string

# ── OTP delivery ──────────────────────────────────────────────────────────
# Leave ALL of these blank to use the dev "console" transport (the OTP is
# printed to the server log) — handy for local testing with zero setup.
#
# Email OTP via SMTP (Gmail app password, SendGrid SMTP, AWS SES, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Act For Change <no-reply@actforchange.in>"
#
# SMS OTP via Twilio (run `npm i twilio` to enable)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
